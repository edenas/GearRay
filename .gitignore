# Canonical generated build trees and safety net for legacy experiments
/build/
/build-*/
/tools/.cache/
/artifacts/local-history/
/tools/performance/local.json
# Post-push local receipts cannot be part of the commit they identify.
/docs/maintenance/2026-10-23/implementation/publication.json
/docs/maintenance/2026-10-23/implementation/PUBLICATION_RESULT.md
/docs/maintenance/2026-10-23/implementation/post-publication-metrics.json
/docs/maintenance/2026-10-23/implementation/post-publication-census.zip

