# Local build output
/build/*
!/build/.gitkeep
/build-profile/*
/build-*/

# Local Python caches
__pycache__/
*.py[cod]

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake.user

# Compiled objects and binaries
*.obj
*.o
*.lib
*.a
*.exe
*.dll
*.pdb

# Game Gear / Master System generated ROM artifacts
*.gg
*.sms
*.ihx
*.lk
*.lst
*.map
*.noi
*.rel
*.sym

# Keep the selected release ROM; other packaged builds stay local.
/rom/*
!/rom/GearRay-verified-20261019.gg

# Frozen performance evidence is deliberately versioned.
!/docs/performance/2026-10-19/evidence/**/*.gg
!/docs/performance/2026-10-19/evidence/**/*.lk
!/docs/performance/2026-10-19/evidence/**/*.map
!/docs/performance/2026-10-19/evidence/**/*.noi

# Editor and OS files
.vs/
.vscode/
Corel Auto-Preserve/
.artifact-quarantine/
/artifacts/game-over-playtest/
/artifacts/manual-playtest/
/artifacts/near-detail-playtest/
/rom/GearRay-profile
*.lnk
*.suo
*.user
*.swp
Thumbs.db
Desktop.ini
